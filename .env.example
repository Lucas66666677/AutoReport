# Frontend (Vercel)
VITE_API_URL=http://localhost:8000
VITE_COLLABORATION_URL=ws://localhost:1234
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_ENABLE_BILLING=false
VITE_ENABLE_GITHUB_AUTH=false
VITE_ENABLE_GITHUB_SYNC=false
VITE_ENABLE_GOOGLE_DRIVE=false
VITE_ENABLE_SCREEN_RECORDING=false
VITE_ENABLE_REALTIME_COLLABORATION=false
VITE_ENABLE_BROWSER_EXTENSION=false

# Backend (Render / local FastAPI)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ENCRYPTION_KEY=generate-with-python-cryptography-fernet
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash
FREE_DAILY_AI_QUOTA=3
PRO_DAILY_AI_QUOTA=300
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PRO_PRICE_ID=price_your-pro-plan-price-id
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STRIPE_BILLING_ENABLED=false
GITHUB_SYNC_ENABLED=false
GOOGLE_DRIVE_ENABLED=false
OWNERSHIP_TRANSFER_EMAIL_CONFIGURED=false
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_OAUTH_STATE_SECRET=generate-a-long-random-string

# Collaboration server (keep service role server-side only)
PORT=1234
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COLLABORATION_ENABLED=false
YJS_STORE_DEBOUNCE_MS=2000
YJS_STORE_MAX_DEBOUNCE_MS=10000
